rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entities Validation ---
    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.createdAt == request.time;
    }

    function isValidTestResult(data) {
      return data.userId == request.auth.uid &&
             data.archetypeKey is string && data.archetypeKey.size() <= 50 &&
             data.scores is map &&
             data.createdAt == request.time;
    }

    function isValidLead(data) {
      return data.email is string && 
             data.email.size() >= 5 && data.email.size() <= 200 &&
             data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
             data.archetypeKey is string && data.archetypeKey.size() <= 50 &&
             data.consent == true &&
             data.createdAt == request.time &&
             data.keys().hasAll(['email', 'archetypeKey', 'consent', 'createdAt']) &&
             data.keys().hasOnly(['email', 'archetypeKey', 'archetypeName', 'consent', 'source', 'createdAt']);
    }

    function isValidVipToken(data) {
      return data.token is string && data.token.size() >= 3 && data.token.size() <= 64 &&
             data.recipientName is string && data.recipientName.size() <= 100 &&
             data.used is bool &&
             data.useCount is number &&
             data.createdAt == request.time &&
             data.keys().hasAll(['token', 'recipientName', 'used', 'useCount', 'createdAt']) &&
             data.keys().hasOnly(['token', 'recipientName', 'archetypeKey', 'note', 'used', 'useCount', 'usedAt', 'usedBy', 'createdAt']);
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) &&
                       isValidUser(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']);
    }

    match /testResults/{resultId} {
      allow get: if isOwner(existing().userId);
      allow list: if isOwner(request.auth.uid) && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidTestResult(incoming());
      // Results are immutable
      allow update, delete: if false;
    }

    match /leads/{leadId} {
      // Allows prospective users to submit their email to receive their profile results
      allow create: if isValidLead(incoming());
      // Direct reading, listing and updating are blocked to protect user PII
      allow read, update, delete: if false;
    }

    match /vipTokens/{tokenId} {
      // Anyone with the specific token ID can inspect it for redemption
      allow get: if true;
      // List tokens for administrative dashboard
      allow list: if true;
      // Token creation
      allow create: if isValidVipToken(incoming()) && incoming().used == false && incoming().useCount == 0;
      // Token redemption (single-use lock)
      allow update: if existing().used == false &&
                       incoming().used == true &&
                       incoming().useCount == 1 &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['used', 'useCount', 'usedAt', 'usedBy']);
      // Deletion allowed for admin cleanup
      allow delete: if true;
    }
  }
}
